<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tutor.system.mapper.CustomerAccountMapper">

    <resultMap type="CustomerAccount" id="CustomerAccountResult">
        <id     property="accountId"     column="account_id"/>
        <result property="email"         column="email"/>
        <result property="password"      column="password"/>
        <result property="nickname"      column="nickname"/>
        <result property="role"          column="role"/>
        <result property="status"        column="status"/>
        <result property="lastLoginTime" column="last_login_time"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateTime"    column="update_time"/>
    </resultMap>

    <sql id="selectAccountVo">
        select account_id, email, password, nickname, role, status,
               last_login_time, create_time, update_time
        from t_customer_account
    </sql>

    <select id="selectByEmail" parameterType="String" resultMap="CustomerAccountResult">
        <include refid="selectAccountVo"/>
        where email = #{email}
        limit 1
    </select>

    <select id="selectById" parameterType="Long" resultMap="CustomerAccountResult">
        <include refid="selectAccountVo"/>
        where account_id = #{accountId}
    </select>

    <!-- 管理后台列表：不查 password，少一份泄漏风险 -->
    <sql id="selectAccountListVo">
        select account_id, email, nickname, role, status,
               last_login_time, create_time, update_time
        from t_customer_account
    </sql>

    <select id="selectAccountList" parameterType="CustomerAccount" resultMap="CustomerAccountResult">
        <include refid="selectAccountListVo"/>
        <where>
            <if test="role != null and role != ''"> and role = #{role}</if>
            <if test="email != null and email != ''"> and email like concat('%', #{email}, '%')</if>
            <if test="nickname != null and nickname != ''"> and nickname like concat('%', #{nickname}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc, account_id desc
    </select>

    <select id="selectByIds" resultMap="CustomerAccountResult">
        <include refid="selectAccountVo"/>
        where account_id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <insert id="insertAccount" parameterType="CustomerAccount" useGeneratedKeys="true" keyProperty="accountId">
        insert into t_customer_account
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="email != null and email != ''">email,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="nickname != null">nickname,</if>
            <if test="role != null">role,</if>
            <if test="status != null">status,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="email != null and email != ''">#{email},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="nickname != null">#{nickname},</if>
            <if test="role != null">#{role},</if>
            <if test="status != null">#{status},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateAccount" parameterType="CustomerAccount">
        update t_customer_account
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="role != null">role = #{role},</if>
            <if test="status != null">status = #{status},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="lastLoginTime != null">last_login_time = #{lastLoginTime},</if>
            update_time = sysdate()
        </set>
        where account_id = #{accountId}
    </update>

</mapper>
