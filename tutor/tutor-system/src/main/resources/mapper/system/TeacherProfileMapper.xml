<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tutor.system.mapper.TeacherProfileMapper">

    <resultMap type="TeacherProfile" id="TeacherProfileResult">
        <id     property="accountId"       column="account_id"/>
        <result property="realName"        column="real_name"/>
        <result property="gender"          column="gender"/>
        <result property="age"             column="age"/>
        <result property="city"            column="city"/>
        <result property="education"       column="education"/>
        <result property="school"          column="school"/>
        <result property="major"           column="major"/>
        <result property="subjects"        column="subjects"/>
        <result property="grades"          column="grades"/>
        <result property="hourlyRate"      column="hourly_rate"/>
        <result property="experienceYears" column="experience_years"/>
        <result property="availableTime"   column="available_time"/>
        <result property="intro"           column="intro"/>
        <result property="certificates"    column="certificates"/>
        <result property="contact"         column="contact"/>
        <result property="createTime"      column="create_time"/>
        <result property="updateTime"      column="update_time"/>
    </resultMap>

    <sql id="selectProfileVo">
        select account_id, real_name, gender, age, city, education, school, major,
               subjects, grades, hourly_rate, experience_years, available_time,
               intro, certificates, contact, create_time, update_time
        from t_teacher_profile
    </sql>

    <select id="selectByAccountId" parameterType="Long" resultMap="TeacherProfileResult">
        <include refid="selectProfileVo"/>
        where account_id = #{accountId}
    </select>

    <insert id="insertProfile" parameterType="TeacherProfile">
        insert into t_teacher_profile
        <trim prefix="(" suffix=")" suffixOverrides=",">
            account_id,
            <if test="realName != null">real_name,</if>
            <if test="gender != null">gender,</if>
            <if test="age != null">age,</if>
            <if test="city != null">city,</if>
            <if test="education != null">education,</if>
            <if test="school != null">school,</if>
            <if test="major != null">major,</if>
            <if test="subjects != null">subjects,</if>
            <if test="grades != null">grades,</if>
            <if test="hourlyRate != null">hourly_rate,</if>
            <if test="experienceYears != null">experience_years,</if>
            <if test="availableTime != null">available_time,</if>
            <if test="intro != null">intro,</if>
            <if test="certificates != null">certificates,</if>
            <if test="contact != null">contact,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{accountId},
            <if test="realName != null">#{realName},</if>
            <if test="gender != null">#{gender},</if>
            <if test="age != null">#{age},</if>
            <if test="city != null">#{city},</if>
            <if test="education != null">#{education},</if>
            <if test="school != null">#{school},</if>
            <if test="major != null">#{major},</if>
            <if test="subjects != null">#{subjects},</if>
            <if test="grades != null">#{grades},</if>
            <if test="hourlyRate != null">#{hourlyRate},</if>
            <if test="experienceYears != null">#{experienceYears},</if>
            <if test="availableTime != null">#{availableTime},</if>
            <if test="intro != null">#{intro},</if>
            <if test="certificates != null">#{certificates},</if>
            <if test="contact != null">#{contact},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateProfile" parameterType="TeacherProfile">
        update t_teacher_profile
        <set>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="age != null">age = #{age},</if>
            <if test="city != null">city = #{city},</if>
            <if test="education != null">education = #{education},</if>
            <if test="school != null">school = #{school},</if>
            <if test="major != null">major = #{major},</if>
            <if test="subjects != null">subjects = #{subjects},</if>
            <if test="grades != null">grades = #{grades},</if>
            <if test="hourlyRate != null">hourly_rate = #{hourlyRate},</if>
            <if test="experienceYears != null">experience_years = #{experienceYears},</if>
            <if test="availableTime != null">available_time = #{availableTime},</if>
            <if test="intro != null">intro = #{intro},</if>
            <if test="certificates != null">certificates = #{certificates},</if>
            <if test="contact != null">contact = #{contact},</if>
            update_time = sysdate()
        </set>
        where account_id = #{accountId}
    </update>

</mapper>
