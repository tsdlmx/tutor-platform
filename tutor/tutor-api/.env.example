APP_ENV=development
HTTP_ADDR=127.0.0.1:12501
DATABASE_DSN=postgres://tutor_app:change-me@127.0.0.1:5432/tutor?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
# Only network ranges of reverse proxies you operate; forwarded headers are otherwise ignored.
TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Browser origins allowed to call this API cross-origin. Empty means same-origin only.
# A wildcard is rejected when APP_ENV=production.
CORS_ALLOWED_ORIGINS=
# Optional direct TLS termination. Leave both empty when a trusted reverse proxy terminates TLS.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Version identifier of the published privacy policy and user agreement. Required
# in production: it is stored with every registration consent.
PRIVACY_POLICY_VERSION=

# Configure all three before enabling email verification.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Used only by cmd/import-legacy. Use a MySQL account granted SELECT only.
LEGACY_MYSQL_DSN=
