# 生产环境
#
# 前端只访问两个前缀，二者都由反向代理转发到 Go 服务：
#   /web-api   —— 客户 Web
#   /admin-api —— 管理员认证与管理接口
# 没有默认后端前缀：请求漏写 baseURL 会打到同源并直接 404。
# 反代必须转发这两个前缀，否则页面会 404。
VITE_CUSTOMER_API_BASE_URL=/web-api
VITE_WEB_API_PROXY_PREFIX=/web-api
VITE_WEB_API_PROXY_TARGET=http://127.0.0.1:12501
VITE_ADMIN_API_PROXY_PREFIX=/admin-api
VITE_ADMIN_API_PROXY_TARGET=http://127.0.0.1:12501

# 生产环境默认关闭 mock，走真实后端
VITE_USE_MOCK=false
# 后端静态资源直连地址，留空表示与站点同源
VITE_ASSET_BASE_URL=

# 隐私政策与用户协议的公开地址（注册页勾选同意时链接到此）；上线前必须配置
VITE_PRIVACY_POLICY_URL=
