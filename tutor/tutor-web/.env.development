# 开发环境 —— 通过 Vite dev server 代理到 Spring Boot
# 前端请求前缀（会被 vite proxy 截掉）
VITE_API_BASE_URL=/dev-api
# 代理前缀
VITE_PROXY_PREFIX=/dev-api
# 后端地址（后端跑在 12501，同时对外网开放）
VITE_PROXY_TARGET=http://127.0.0.1:12501
# 后端静态资源（/profile/** 上传目录）直连地址，留空表示与站点同源
VITE_ASSET_BASE_URL=
# 是否启用内置 mock 数据（后端未启动时的降级演示；默认 false 走真实接口）
VITE_USE_MOCK=false

VITE_CUSTOMER_API_BASE_URL=/web-api
# 已迁移到 Go 服务的前缀（不经过 /dev-api）
# 生产反代必须把这两个前缀转发到 Go 服务，否则已迁移页面会 404。
VITE_WEB_API_PROXY_PREFIX=/web-api
VITE_WEB_API_PROXY_TARGET=http://127.0.0.1:12501
VITE_ADMIN_API_PROXY_PREFIX=/admin-api
VITE_ADMIN_API_PROXY_TARGET=http://127.0.0.1:12501
